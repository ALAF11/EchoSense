".endWindow": {
    backgroundColor: "#0A2E3D",
    orientationModes: [Ti.UI.LANDSCAPE_LEFT, Ti.UI.LANDSCAPE_RIGHT],
    layout: "composite"
}

".background": {
    width: 900,
    height: 950,
    backgroundImage: "img/background_echosense.png",
    center: { x: "50%", y: "50%" },
    opacity: 0.7,
    zIndex: 0
}

".header": {
    width: Ti.UI.SIZE,
    height: Ti.UI.SIZE,
    layout: "horizontal",
    top: 15,
    zIndex: 2,
    left: 40,
    shadowColor: "rgba(0, 0, 0, 0.4)",
    shadowOffset: { x: 0, y: 3 },
    shadowRadius: 5
}

"#logoSmall": {
    width: 35,
    height: 43
}

".headerTitleRow": {
    width: Ti.UI.SIZE,
    height: Ti.UI.SIZE,
    layout: "horizontal",
    left: 10,
    top: 10
}

".headerTitleEcho": {
    text: "Echo",
    font: {
        fontSize: 20,
        fontFamily: "Poppins-SemiBold"
    },
    color: "#2495A1",
    width: Ti.UI.SIZE,
    height: Ti.UI.SIZE,
    shadowColor: "rgba(0, 0, 0, 0.5)",
    shadowOffset: { x: 0, y: 2 },
    shadowRadius: 4
}

".headerTitleSense": {
    text: "Sense",
    font: {
        fontSize: 20,
        fontFamily: "Poppins-SemiBold"
    },
    color: "#FFFFFF",
    width: Ti.UI.SIZE,
    height: Ti.UI.SIZE,
    left: 0,
    shadowColor: "rgba(0, 0, 0, 0.5)",
    shadowOffset: { x: 0, y: 2 },
    shadowRadius: 4
}

".navBar": {
    width: 600,
    height: 35,
    layout: "horizontal",
    borderRadius: 18,
    borderWidth: 2,
    borderColor: "#387482",
    backgroundColor: "rgba(0, 23, 32, 0.3)",
    top: 22,
    right: 40,
    zIndex: 2,
    shadowColor: "rgba(0, 0, 0, 0.4)",
    shadowOffset: { x: 0, y: 2 },
    shadowRadius: 5
}

".navItem": {
    font: {
        fontSize: 14,
        fontFamily: "Poppins-Medium"
    },
    color: "#FFFFFF",
    textAlign: "center",
    width: 100,
    height: Ti.UI.FILL,
    touchEnabled: true,
    verticalAlign: Ti.UI.TEXT_VERTICAL_ALIGNMENT_CENTER
}

".navItemActive": {
    color: "#FBA71E",
    font: {
        fontSize: 14,
        fontFamily: "Poppins-SemiBold"
    }
}

".mainContent": {
    width: Ti.UI.SIZE,
    height: Ti.UI.SIZE,
    layout: "vertical",
    top: 90,
    zIndex: 1,
    center: { x: "50%" }
}

".summaryCard": {
    width: 700,
    height: 250,
    borderRadius: 20,
    borderWidth: 2,
    borderColor: "#387482",
    backgroundColor: "rgba(0, 23, 32, 0.3)",
    layout: "composite",
    shadowColor: "rgba(0, 0, 0, 0.5)",
    shadowOffset: { x: 0, y: 4 },
    shadowRadius: 8
}

".cardTitle": {
    top: 15,
    font: {
        fontSize: 26,
        fontFamily: "Poppins-SemiBold"
    },
    color: "#FBA71E",
    textAlign: "center",
    width: Ti.UI.FILL,
    height: Ti.UI.SIZE,
    shadowColor: "rgba(0, 0, 0, 0.5)",
    shadowOffset: { x: 0, y: 2 },
    shadowRadius: 4
}

".successIcon": {
    width: 50,
    height: 50,
    top: 65,
    left: 50
}

".infoContainer": {
    width: 580,
    height: Ti.UI.SIZE,
    layout: "vertical",
    top: 65,
    center: { x: "55%" }
}

".infoRow": {
    width: Ti.UI.FILL,
    height: Ti.UI.SIZE,
    layout: "horizontal",
    top: 8
}

".infoLabel": {
    font: {
        fontSize: 18,
        fontFamily: "Poppins-Regular"
    },
    color: "#FFFFFF",
    textAlign: "left",
    width: 240,
    height: Ti.UI.SIZE
}

".infoValue": {
    font: {
        fontSize: 18,
        fontFamily: "Poppins-SemiBold"
    },
    color: "#2495A1",
    textAlign: "left",
    width: 340,
    height: Ti.UI.SIZE,
    left: 0
}

".bottomActionContainer": {
    width: Ti.UI.SIZE,
    height: Ti.UI.SIZE,
    layout: "horizontal",
    bottom: 18,
    zIndex: 2,
    center: { x: "50%" }
}

".actionButton": {
    height: 38,
    borderRadius: 19,
    font: {
        fontSize: 17,
        fontFamily: "Poppins-SemiBold"
    },
    textAlign: "center",
    shadowColor: "rgba(0, 0, 0, 0.4)",
    shadowOffset: { x: 0, y: 2 },
    shadowRadius: 4
}

".deactivateButton": {
    width: 180,
    backgroundColor: "#FFFFFF",
    color: "#2495A1",
    left: 0
}

".newMissionButton": {
    width: 180,
    backgroundColor: "#46D365",
    color: "#FFFFFF",
    left: 20
}
