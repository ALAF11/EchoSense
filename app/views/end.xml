<Alloy>
	<Window id="endWindow" class="endWindow">
		<!-- Background Image -->
		<View class="background" />
		
		<!-- Header Container -->
		<View class="header" onClick="backToHome">
			<!-- Logo -->
			<ImageView id="logoSmall" image="img/logo.png" />
			
			<!-- Title Row -->
			<View class="headerTitleRow">
				<Label class="headerTitleEcho">Echo</Label>
				<Label class="headerTitleSense">Sense</Label>
			</View>
		</View>
		
		<!-- Navigation Bar -->
		<View class="navBar">
			<Label class="navItem" onClick="navigateToStatus">Status</Label>
			<Label class="navItem" onClick="navigateToFrequency">Frequency</Label>
			<Label class="navItem" onClick="navigateToTriggerCode">Trigger Code</Label>
			<Label class="navItem" onClick="navigateToMission">Mission</Label>
			<Label class="navItem" onClick="navigateToRecapture">Recapture</Label>
			<Label class="navItem navItemActive">End</Label>
		</View>
		
		<!-- Main Content Container -->
		<View class="mainContent">
			<!-- Mission Summary Card -->
			<View class="summaryCard">
				<Label class="cardTitle">MISSION SUMMARY</Label>
				
				<!-- Success Icon -->
				<ImageView id="successIcon" class="successIcon" image="img/Recovered.png" />
				
				<!-- Mission Info Container -->
				<View class="infoContainer">
					<!-- Mission ID -->
					<View class="infoRow">
						<Label class="infoLabel">Mission ID:</Label>
						<Label id="missionId" class="infoValue">MARS-2025-016</Label>
					</View>
					
					<!-- Total Mission Time -->
					<View class="infoRow">
						<Label class="infoLabel">Total Mission Time:</Label>
						<Label id="totalMissionTime" class="infoValue">01 : 27 : 54</Label>
					</View>
					
					<!-- Deployment Location -->
					<View class="infoRow">
						<Label class="infoLabel">Deployment Location:</Label>
						<Label id="deploymentLocation" class="infoValue">37.380°N, 11.591°E</Label>
					</View>
					
					<!-- Recovery Location -->
					<View class="infoRow">
						<Label class="infoLabel">Recovery Location:</Label>
						<Label id="recoveryLocation" class="infoValue">37.385°N, 11.598°E</Label>
					</View>
				</View>
			</View>
		</View>
		
		<!-- Bottom Action Buttons Container -->
		<View class="bottomActionContainer">
			<Button id="deactivateButton" class="actionButton deactivateButton" onClick="deactivateBuoy">DESACTIVATE</Button>
			<Button id="newMissionButton" class="actionButton newMissionButton" onClick="startNewMission">NEW MISSION</Button>
		</View>
	</Window>
</Alloy>